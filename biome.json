{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!.venv",
      "!.venv-*",
      "!backend/.venv",
      "!backend/.venv-bonsai",
      "!backend/.venv-kokoclone",
      "!backend/.venv-*",
      "!backend/go.sum",
      "!backend/data",
      "!backend/model",
      "!backend/model-cache",
      "!backend/voice",
      "!.playwright-cli",
      "!.playwright-mcp",
      "!.upstreams",
      "!demo",
      "!model",
      "!output",
      "!voice",
      "!node_modules",
      "!dist",
      "!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
