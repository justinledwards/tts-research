    "activeStates": ["accepted", "queued", "optimizing", "synthesizing", "checking"],
    "branches": [
      {
        "from": "anyActive",
        "to": "cancelRequested",
        "then": "cancelled"
      },
      {
        "from": "anyActive",
        "to": "interruptedRetriable",
