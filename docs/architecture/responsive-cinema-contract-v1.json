  "narrationRunContract": {
    "executionStates": [
      "idle",
      "accepted",
      "queued",
      "optimizing",
      "synthesizing",
      "checking",
      "completed",
      "cancelRequested",
      "cancelled",
      "interruptedRetriable",
      "failed"
