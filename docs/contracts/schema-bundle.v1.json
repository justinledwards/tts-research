{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "tts-research-contracts",
  "version": "v1",
  "schemas": {
    "content-ir.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://tts-research.local/schemas/content-ir.v1.schema.json",
      "title": "Content IR v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "sourceType",
        "sourceId",
        "projectId",
        "sourceName",
        "adapterVersion",
        "generatedAt",
        "nodes"
      ],
      "properties": {
        "schemaVersion": {
          "const": "content-ir.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string"
        },
        "sourceName": {
          "type": "string"
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "$defs": {
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeId",
            "parentId",
            "orderKey",
            "kind",
            "role",
            "displayText",
            "normalisedText",
            "speechText",
            "lang",
            "script",
            "dir",
            "provenance",
            "ui",
            "speech",
            "warnings",
            "confidence",
            "rights",
            "adapterVersion"
          ],
          "properties": {
            "nodeId": {
              "type": "string",
              "minLength": 1
            },
            "parentId": {
              "type": "string"
            },
            "orderKey": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string"
            },
            "displayText": {
              "type": "string"
            },
            "normalisedText": {
              "type": "string"
            },
            "speechText": {
              "type": "string"
            },
            "lang": {
              "type": "string"
            },
            "script": {
              "type": "string"
            },
            "dir": {
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            },
            "ui": {
              "$ref": "#/$defs/ui"
            },
            "speech": {
              "$ref": "#/$defs/speech"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rights": {
              "$ref": "#/$defs/rights"
            },
            "metadata": {
              "$ref": "#/$defs/metadata"
            },
            "pronunciationRefs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pronunciationRef"
              }
            },
            "lexiconEntryIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "phoneme": {
              "type": "string"
            },
            "alphabet": {
              "type": "string"
            },
            "sayAs": {
              "type": "string"
            },
            "markId": {
              "type": "string"
            },
            "adapterVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pronunciationRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["term", "spoken", "startOffset", "endOffset", "originalText"],
          "properties": {
            "term": {
              "type": "string"
            },
            "spoken": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "entryId": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "protected": {
              "type": "boolean"
            },
            "startOffset": {
              "type": "integer",
              "minimum": 0
            },
            "endOffset": {
              "type": "integer",
              "minimum": 0
            },
            "originalText": {
              "type": "string"
            },
            "phoneme": {
              "type": "string"
            },
            "alphabet": {
              "type": "string"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sourceId", "locator", "offsets"],
          "properties": {
            "format": {
              "type": "string",
              "minLength": 1
            },
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "offsets": {
              "$ref": "#/$defs/offsets"
            },
            "extraction": {
              "$ref": "#/$defs/extractionProvenance"
            }
          }
        },
        "extractionProvenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extractor", "extractorVersion", "supportTier", "step", "confidence"],
          "properties": {
            "extractor": {
              "type": "string"
            },
            "extractorVersion": {
              "type": "string"
            },
            "supportTier": {
              "type": "string"
            },
            "step": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "offsets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "enum": ["markdown", "html", "epub", "pdf", "docx", "ocr"]
            },
            "markdown": {
              "$ref": "#/$defs/markdownLocator"
            },
            "html": {
              "$ref": "#/$defs/htmlLocator"
            },
            "epub": {
              "$ref": "#/$defs/epubLocator"
            },
            "pdf": {
              "$ref": "#/$defs/pdfLocator"
            },
            "docx": {
              "$ref": "#/$defs/docxLocator"
            },
            "ocr": {
              "$ref": "#/$defs/ocrLocator"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "markdown"
                  }
                }
              },
              "then": {
                "required": ["markdown"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "html"
                  }
                }
              },
              "then": {
                "required": ["html"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "epub"
                  }
                }
              },
              "then": {
                "required": ["epub"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "pdf"
                  }
                }
              },
              "then": {
                "required": ["pdf"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "docx"
                  }
                }
              },
              "then": {
                "required": ["docx"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "ocr"
                  }
                }
              },
              "then": {
                "required": ["ocr"]
              }
            }
          ]
        },
        "markdownLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "lineStart", "lineEnd", "columnStart", "columnEnd", "astPath"],
          "properties": {
            "path": {
              "type": "string"
            },
            "lineStart": {
              "type": "integer",
              "minimum": 0
            },
            "lineEnd": {
              "type": "integer",
              "minimum": 0
            },
            "columnStart": {
              "type": "integer",
              "minimum": 0
            },
            "columnEnd": {
              "type": "integer",
              "minimum": 0
            },
            "astPath": {
              "type": "string"
            }
          }
        },
        "htmlLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href", "fragment"],
          "properties": {
            "href": {
              "type": "string"
            },
            "fragment": {
              "type": "string"
            },
            "textQuote": {
              "type": "string"
            },
            "progression": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "epubCfi": {
              "type": "string"
            }
          }
        },
        "epubLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href"],
          "properties": {
            "href": {
              "type": "string"
            },
            "fragment": {
              "type": "string"
            },
            "textQuote": {
              "type": "string"
            },
            "progression": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "epubCfi": {
              "type": "string"
            },
            "spineId": {
              "type": "string"
            }
          }
        },
        "pdfLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pageIndex"],
          "properties": {
            "pageIndex": {
              "type": "integer",
              "minimum": 0
            },
            "bbox": {
              "$ref": "#/$defs/bbox"
            },
            "polygon": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            "readingOrderIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "docxLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paragraphIndex"],
          "properties": {
            "paragraphIndex": {
              "type": "integer",
              "minimum": 0
            },
            "runIndex": {
              "type": "integer",
              "minimum": 0
            },
            "bookmarkId": {
              "type": "string"
            }
          }
        },
        "ocrLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pageIndex", "polygon", "ocrEngine", "ocrConfidence"],
          "properties": {
            "pageIndex": {
              "type": "integer",
              "minimum": 0
            },
            "polygon": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            "ocrEngine": {
              "type": "string"
            },
            "ocrConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "point": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "required": ["progressionHint", "highlightUnitHint"],
          "properties": {
            "progressionHint": {
              "type": "string"
            },
            "highlightUnitHint": {
              "type": "string"
            }
          }
        },
        "speech": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policyHint", "speechPolicy"],
          "properties": {
            "policyHint": {
              "$ref": "#/$defs/speechPolicyHint"
            },
            "speechPolicy": {
              "$ref": "#/$defs/speechPolicy"
            }
          }
        },
        "speechPolicyHint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "emphasis", "pauseBeforeMs", "pauseAfterMs"],
          "properties": {
            "mode": {
              "type": "string"
            },
            "emphasis": {
              "type": "string"
            },
            "pauseBeforeMs": {
              "type": "integer"
            },
            "pauseAfterMs": {
              "type": "integer"
            }
          }
        },
        "speechPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "mode", "explanation"],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string"
            },
            "elementMode": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "explanation": {
              "type": "string"
            }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "notes"],
          "properties": {
            "status": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "locator-envelope.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://tts-research.local/schemas/locator-envelope.v1.schema.json",
      "title": "Locator Envelope v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "sourceId"],
      "properties": {
        "schemaVersion": {
          "const": "locator-envelope.v1"
        },
        "kind": {
          "enum": ["resume", "bookmark", "highlight"]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string"
        },
        "scopeKey": {
          "type": "string"
        },
        "activeWordIndex": {
          "type": "integer",
          "minimum": 0
        },
        "locator": {
          "$ref": "content-ir.v1.schema.json#/$defs/locator"
        },
        "readium": {
          "$ref": "#/$defs/readiumLocator"
        },
        "textQuote": {
          "type": "string"
        }
      },
      "$defs": {
        "readiumLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href", "type"],
          "properties": {
            "href": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "locations": {
              "$ref": "#/$defs/readiumLocations"
            },
            "text": {
              "$ref": "#/$defs/readiumText"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "readiumLocations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fragments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "progression": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "totalProgression": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "position": {
              "type": "integer",
              "minimum": 1
            },
            "cssSelector": {
              "type": "string"
            },
            "partialCfi": {
              "type": "string"
            }
          }
        },
        "readiumText": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "before": {
              "type": "string"
            },
            "highlight": {
              "type": "string"
            },
            "after": {
              "type": "string"
            }
          }
        }
      }
    },
    "speech-plan.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://tts-research.local/schemas/speech-plan.v1.schema.json",
      "title": "Speech Plan v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "sourceId", "projectId", "generatedAt", "segments"],
      "properties": {
        "schemaVersion": {
          "const": "speech-plan.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "policyTrace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policyTrace"
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "$defs": {
        "segment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "segmentId",
            "index",
            "nodeId",
            "text",
            "lang",
            "speechPolicy",
            "policyTrace",
            "locatorEnvelope",
            "serializerTargets"
          ],
          "properties": {
            "segmentId": {
              "type": "string",
              "minLength": 1
            },
            "index": {
              "type": "integer",
              "minimum": 1
            },
            "nodeId": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "lang": {
              "type": "string"
            },
            "speechPolicy": {
              "$ref": "content-ir.v1.schema.json#/$defs/speechPolicy"
            },
            "policyTrace": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/policyTrace"
              }
            },
            "locatorEnvelope": {
              "$ref": "locator-envelope.v1.schema.json"
            },
            "pronunciationRefs": {
              "type": "array",
              "items": {
                "$ref": "content-ir.v1.schema.json#/$defs/pronunciationRef"
              }
            },
            "lexiconEntryIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "serializerTargets": {
              "$ref": "#/$defs/serializerTargets"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "policyTrace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "profile"],
          "properties": {
            "scope": {
              "enum": [
                "marketProfileDefault",
                "projectOverride",
                "sourceOverride",
                "sessionOverride"
              ]
            },
            "profile": {
              "type": "string"
            },
            "overrides": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "serializerTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plainText", "highlightMarks"],
          "properties": {
            "plainText": {
              "type": "string"
            },
            "ssml": {
              "type": "string"
            },
            "plsRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "highlightMarks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/highlightMark"
              }
            }
          }
        },
        "highlightMark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["markId", "nodeId"],
          "properties": {
            "markId": {
              "type": "string"
            },
            "nodeId": {
              "type": "string"
            },
            "segmentId": {
              "type": "string"
            }
          }
        }
      }
    },
    "highlight-map.v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://tts-research.local/schemas/highlight-map.v1.schema.json",
      "title": "Highlight Map v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "source",
        "mode",
        "durationMs",
        "generatedAt",
        "summary",
        "fragments",
        "tokens"
      ],
      "properties": {
        "schemaVersion": {
          "const": "highlight-map.v1"
        },
        "jobId": {
          "type": "string"
        },
        "bookSourceId": {
          "type": "string"
        },
        "scopeKey": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "$ref": "fragment-timing.v1.schema.json#/$defs/timingSource"
        },
        "mode": {
          "$ref": "#/$defs/highlightMode"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "policy": {
          "$ref": "#/$defs/confidencePolicy"
        },
        "summary": {
          "$ref": "#/$defs/highlightMapSummary"
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/highlightFragment"
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/highlightToken"
          }
        },
        "warnings": {
          "$ref": "fragment-timing.v1.schema.json#/$defs/warnings"
        }
      },
      "$defs": {
        "highlightMode": {
          "type": "string",
          "enum": ["word", "phrase"]
        },
        "confidencePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minSegmentConfidence", "minTokenConfidence", "maxDriftMs", "maxDriftRatio"],
          "properties": {
            "minSegmentConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minTokenConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxDriftMs": {
              "type": "integer",
              "minimum": 0
            },
            "maxDriftRatio": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "readingPosition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bookSourceId": {
              "type": "string"
            },
            "scopeKey": {
              "type": "string"
            },
            "activeWordIndex": {
              "type": "integer",
              "minimum": 0
            },
            "nodeId": {
              "type": "string"
            },
            "locator": {
