    "./schemas/fragment-timing.v1.schema.json": "./schemas/fragment-timing.v1.schema.json",
    "./schemas/token-timing.v1.schema.json": "./schemas/token-timing.v1.schema.json",
    "./schemas/source-envelope.v1.schema.json": "./schemas/source-envelope.v1.schema.json",
    "./schemas/source-revision.v1.schema.json": "./schemas/source-revision.v1.schema.json",
    "./schemas/extraction-revision.v1.schema.json": "./schemas/extraction-revision.v1.schema.json",
