{
  "name": "tts-research",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "files": [
    "README.md",
    "docs/sdk"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @tts-research/backend --filter @tts-research/frontend dev",
    "start": "bash ./scripts/start.sh",
    "start:local": "VOICE_OPTIMIZER_PROVIDER=rules TTS_PROVIDER=kokoro VOICE_CHECKER_PROVIDER=mock KOKORO_DEVICE=cpu QWEN_ASR_DEVICE=cpu bash ./scripts/start.sh",
    "start:local-checked": "VOICE_OPTIMIZER_PROVIDER=rules TTS_PROVIDER=kokoro VOICE_CHECKER_PROVIDER=qwen KOKORO_DEVICE=cpu QWEN_ASR_DEVICE=cpu QWEN_ASR_PRELOAD=0 bash ./scripts/start.sh",
    "start:local-bonsai": "VOICE_OPTIMIZER_PROVIDER=bonsai TTS_PROVIDER=kokoro VOICE_CHECKER_PROVIDER=qwen bash ./scripts/start.sh",
    "start:mock": "VOICE_OPTIMIZER_PROVIDER=rules TTS_PROVIDER=mock VOICE_CHECKER_PROVIDER=mock bash ./scripts/start.sh",
    "setup:alignment": "bash ./scripts/runtime-setup.sh setup-alignment",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "review:local": "node scripts/validate-local/review-evidence.mjs",
    "review:zip": "node scripts/zip-branch-for-review.mjs",
    "review:chatgpt": "node scripts/create-chatgpt-review-package.mjs",
    "validate:local": "pnpm validate:local:fast",
    "validate:local:fast": "node scripts/validate-local/validate-local.mjs --lane=fast",
    "validate:local:quick": "VALIDATE_LOCAL_QUICK=1 pnpm validate:local:fast -- --quick",
    "validate:local:guard": "pnpm validate:local:fast -- --guard-regressions",
    "validate:local:e2e": "node scripts/validate-local/validate-local.mjs --lane=e2e",
    "validate:local:release": "node scripts/validate-local/validate-local.mjs --lane=release",
    "validate:local:full": "pnpm validate:local:release",
    "validate:ux-final": "node scripts/validate-local/validate-final-ux-gates.mjs",
    "local:bloat": "node scripts/local-bloat.mjs",
    "local:clean": "node scripts/local-bloat.mjs --clean",
    "bench:local": "node scripts/validate-local/bench-local.mjs",
    "bundle:local": "node scripts/validate-local/frontend-performance.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && eslint --cache --cache-location .cache/eslint .",
    "typecheck": "pnpm --filter @tts-research/frontend typecheck",
    "test": "pnpm package:test && pnpm test:scripts && pnpm test:adapters && pnpm --filter @tts-research/backend test && pnpm --filter @tts-research/frontend test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "package:build": "pnpm --filter @tts-research/schema build && pnpm --filter @tts-research/sdk-ts build && pnpm --filter @tts-research/cli build",
    "package:test": "pnpm package:build && pnpm package:test:core",
    "package:test:core": "pnpm package:boundary && pnpm --filter @tts-research/schema test:core && pnpm --filter @tts-research/sdk-ts test:core && pnpm --filter @tts-research/cli test:core",
    "package:boundary": "node scripts/validate-package-boundaries.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "cli:parity": "pnpm package:build && node scripts/cli-parity.mjs",
    "test:adapters": "pnpm test:markdown-adapter && pnpm test:pdf-adapter",
    "test:markdown-adapter": "node --test \"adapters/**/*.test.js\"",
    "test:pdf-adapter": "python3 -m unittest adapters.pdf.pdf_adapter_test",
    "bench:alignment": "node scripts/bench-alignment.mjs",
    "bench:readalong-sync": "node scripts/bench-readalong-sync.mjs",
    "bench:markdown": "node adapters/markdown/bench.js",
    "generate:contracts": "node scripts/generate-contract-types.mjs",
    "validate:ir": "node scripts/validate-content-ir.mjs",
    "validate:flows": "node scripts/validate-flow-registry.mjs",
    "validate:responsive-architecture": "node scripts/validate-responsive-architecture.mjs",
    "validate:responsive-linear-batch": "node scripts/validate-responsive-linear-batch.mjs",
    "validate:responsive": "pnpm validate:responsive-architecture && pnpm validate:responsive-linear-batch",
    "test:responsive": "node --test scripts/validate-responsive-architecture.test.mjs scripts/validate-responsive-linear-batch.test.mjs",
    "validate:reader-first-release": "node scripts/validate-reader-first-release.mjs",
    "test:reader-first-release": "node --test scripts/validate-reader-first-release.test.mjs",
    "e2e:golden-minute": "node scripts/e2e-golden-minute.mjs",
    "e2e:golden-minute:matrix": "node scripts/e2e-golden-minute-provider-matrix.mjs",
    "e2e:book-cinema": "node scripts/e2e-book-cinema.mjs",
    "e2e:read-along-fidelity": "node scripts/e2e-read-along-fidelity.mjs",
    "e2e:readalong-performance": "node scripts/e2e-readalong-performance.mjs",
    "e2e:readalong-sync": "node scripts/e2e-readalong-sync.mjs",
    "e2e:workspace-flow": "E2E_WORKSPACE_FLOW=1 node scripts/e2e-book-cinema.mjs",
    "e2e:settings-ia": "E2E_SETTINGS_IA=1 node scripts/e2e-book-cinema.mjs",
    "e2e:reader-wayfinding": "E2E_READER_WAYFINDING=1 node scripts/e2e-book-cinema.mjs",
    "e2e:reading-surface": "node scripts/e2e-reading-surface-comparison.mjs",
    "e2e:ui-actions": "node scripts/e2e-ui-action-audit.mjs",
    "build-accessibility-release-artifacts": "node scripts/build-accessibility-release-artifacts.mjs",
    "e2e:accessibility-audit": "node scripts/e2e-accessibility-audit.mjs",
    "e2e:responsive-snapshots": "node scripts/e2e-responsive-snapshots.mjs",
    "e2e:command-palette": "node scripts/e2e-command-palette.mjs",
    "e2e:teleprompt-memory": "node scripts/e2e-teleprompt-memory.mjs",
    "e2e:context-panel": "node scripts/e2e-context-panel.mjs",
    "e2e:ui-action-inventory": "node scripts/e2e-ui-action-inventory.mjs",
    "e2e:navigation-under-processing": "node scripts/e2e-navigation-under-processing.mjs",
    "e2e:ui-actions:quick": "UI_ACTION_AUDIT_QUICK=1 UI_ACTION_AUDIT_MAX_ACTIONS=8 UI_ACTION_AUDIT_WORKER_LIMIT=2 E2E_USE_EXISTING_SERVERS=1 UI_ACTION_AUDIT_SCENARIOS=workspace-review,workspace-preview,workspace-preview-generation-failed,workspace-preview-audition-404,book-docx-audio-ready UI_ACTION_AUDIT_SUMMARY_PATH=./output/ui-action-audit/quick/summary.json UI_ACTION_AUDIT_OUTPUT_DIR=./output/ui-action-audit/quick node scripts/e2e-ui-action-audit.mjs",
    "e2e:ui-actions:smoke": "UI_ACTION_AUDIT_QUICK=1 UI_ACTION_AUDIT_MAX_ACTIONS=4 UI_ACTION_AUDIT_WORKER_LIMIT=1 E2E_USE_EXISTING_SERVERS=1 UI_ACTION_AUDIT_SCENARIOS=workspace-preview UI_ACTION_AUDIT_SUMMARY_PATH=./output/ui-action-audit/smoke/summary.json UI_ACTION_AUDIT_OUTPUT_DIR=./output/ui-action-audit/smoke node scripts/e2e-ui-action-audit.mjs",
    "e2e:ui-actions:guard": "node scripts/e2e-ui-actions-guard.mjs",
    "e2e:surface-complexity": "node scripts/e2e-surface-complexity-budget.mjs",
    "e2e:ui-actions:all": "pnpm e2e:ui-actions && pnpm e2e:ui-actions:guard",
    "ui:component-baseline": "node scripts/ui-component-baseline-snapshots.mjs",
    "e2e:book-cinema:low-resource": "E2E_LOW_RESOURCE=1 node scripts/e2e-book-cinema.mjs",
    "e2e:book-cinema:responsive": "E2E_RESPONSIVE_CINEMA=1 node scripts/e2e-book-cinema.mjs",
    "e2e:temporary-sources": "pnpm e2e:responsive-snapshots && pnpm e2e:teleprompt-memory && pnpm e2e:context-panel && pnpm e2e:command-palette",
    "validate:local:ui": "UI_ACTION_AUDIT_FAIL_ON_FINDINGS=1 pnpm e2e:ui-actions",
    "validate:live-ingestion": "node scripts/validate-live-ingestion.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^9.39.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^8.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.6.1",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  }
}
