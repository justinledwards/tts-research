{
  "name": "tts-research",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @tts-research/backend --filter @tts-research/frontend dev",
    "start": "bash ./scripts/start.sh",
    "start:local": "VOICE_OPTIMIZER_PROVIDER=rules TTS_PROVIDER=kokoro VOICE_CHECKER_PROVIDER=qwen bash ./scripts/start.sh",
    "start:local-bonsai": "VOICE_OPTIMIZER_PROVIDER=bonsai TTS_PROVIDER=kokoro VOICE_CHECKER_PROVIDER=qwen bash ./scripts/start.sh",
    "start:mock": "VOICE_OPTIMIZER_PROVIDER=rules TTS_PROVIDER=mock VOICE_CHECKER_PROVIDER=mock bash ./scripts/start.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && eslint .",
    "typecheck": "pnpm --filter @tts-research/frontend typecheck",
    "test": "pnpm test:markdown-adapter && pnpm --filter @tts-research/backend test && pnpm --filter @tts-research/frontend test",
    "test:markdown-adapter": "node --test adapters/markdown/*.test.js",
    "bench:markdown": "node adapters/markdown/bench.js",
    "e2e:book-cinema": "node scripts/e2e-book-cinema.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^9.39.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "smol-toml": "^1.6.1",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  }
}
