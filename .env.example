BACKEND_PORT=8080
FRONTEND_PORT=5173
# Easy startup port overrides:
# - PORT=5174 changes only the frontend port.
# - API_PORT=8081 changes only the backend port.
# - PORT_BASE=5300 starts frontend on 5300 and backend on 5301.
# Explicit FRONTEND_PORT/BACKEND_PORT win over aliases.
VITE_API_BASE_URL=http://localhost:8080
VOICE_SEGMENT_MAX_RUNES=300
VOICE_SEGMENT_WORKERS=2
VOICE_SEGMENT_MAX_RUNES_STUDIO=220
VOICE_SEGMENT_WORKERS_STUDIO=2
VOICE_SEGMENT_MAX_RUNES_STUDIO_ADAPTIVE=180
VOICE_SEGMENT_WORKERS_STUDIO_ADAPTIVE=2
VOICE_PROFILE_MAX_BYTES=0
VOICE_PROFILE_REFERENCE_MIN_SECONDS=20
VOICE_PROFILE_REFERENCE_TARGET_SECONDS=45
VOICE_PROFILE_REFERENCE_MAX_SECONDS=60
VOICE_PROFILE_SOURCE_DATA_DIR=./data/voice-profile-sources
VOICE_DATA_DIR=./data/voices
FFMPEG_PATH=ffmpeg
VOICE_PROJECT_DATA_DIR=./data/projects
VOICE_PROFILE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
VOICE_PROFILE_DIARIZATION_MODEL_PATH=
VOICE_PROFILE_DIARIZATION_LOCAL_MODEL_DIR=./backend/model/pyannote
VOICE_PROFILE_ANALYSIS_PYTHON_PATH=./backend/.venv/bin/python
VOICE_PROFILE_ANALYSIS_SCRIPT_PATH=./backend/scripts/profile_analyze.py
VOICE_PROFILE_ANALYSIS_STRATEGY_VERSION=speaker-aware-v1
VOICE_PROFILE_DENOISE_PROVIDER=ffmpeg
VOICE_PROFILE_DENOISE_STRENGTH=balanced
VOICE_PROFILE_EMBEDDING_MODEL=pyannote/embedding
VOICE_PROFILE_EMBEDDING_SCRIPT_PATH=./backend/scripts/profile_likeness.py
VOICE_PROFILE_LIKENESS_TIMEOUT_SECONDS=120
PYANNOTE_AUTH_TOKEN=
VOICE_JOB_DATA_DIR=./data/jobs
VOICE_OPTIMIZER_PROVIDER=rules
BONSAI_MODEL=prism-ml/Bonsai-8B-mlx-1bit
BONSAI_PRELOAD=true
BONSAI_MAX_TOKENS=0
BONSAI_CHUNK_RUNES=1600
BONSAI_TIMEOUT_SECONDS=600
BONSAI_TEMPERATURE=0.1
BONSAI_TOP_P=0.9
BONSAI_TOP_K=20
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=180
TTS_PROVIDER=mock
VOICE_CHECKER_PROVIDER=mock
TTS_RESEARCH_USE_TMPFS=1
TTS_RESEARCH_TMPFS_ROOT=/dev/shm/tts-research
TTS_RESEARCH_TMPFS_HF_CACHE=0
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_LANGUAGE=English
QWEN_ASR_PERSISTENT=true
QWEN_ASR_PRELOAD=true
QWEN_ASR_MAX_NEW_TOKENS=256
QWEN_ASR_TIMEOUT_SECONDS=240
QWEN_ASR_SIMILARITY_THRESHOLD=0.82
KOKOCLONE_WORKER_COUNT=2
KOKOCLONE_PYTHON_PATH=./backend/.venv-kokoclone/bin/python
KOKOCLONE_PYTHON_VERSION=3.12
KOKORO_PYTHON_PATH=./backend/.venv/bin/python
KOKORO_EMBED_PYTHON_PATH=./backend/.venv/bin/python
KOKOCLONE_BOOTSTRAP_FLASH_ATTENTION_ON_BOOT=1
KOKOCLONE_FLASH_ATTENTION_WHEEL_ONLY=1
